# Disable PHP and script execution in uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phar|cgi|pl|exe|sh|bat|cmd|js|py)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Force non-executable content type for files
AddType text/plain .html .htm .shtml .php .phtml .php3 .php4 .php5 .phar
